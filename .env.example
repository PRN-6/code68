# Code68 Configuration
# Remote Cloud Inference Server (OpenAI-compatible)
# Example: Kaggle endpoint tunneled via Cloudflare / ngrok / local vLLM / Ollama / OpenRouter
CODE68_BASE_URL=http://localhost:8000/v1
CODE68_API_KEY=code68-secret-key
CODE68_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
CODE68_PROVIDER=openai-compatible

# Security and Permissions
# Options: read-only, edit-approved, auto-edit, command-approved, full-auto
CODE68_PERMISSION_LEVEL=edit-approved

# Performance and Limits
CODE68_TIMEOUT_SECONDS=120
CODE68_MAX_ITERATIONS=25
CODE68_MAX_OUTPUT_CHARS=16000

